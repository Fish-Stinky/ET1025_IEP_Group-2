#include "RichShieldIRremote.h"
#include "RichShieldPassiveBuzzer.h"

#define IR_PIN 2
#define BUZZER_PIN 3
#define BUTTON_CODE 0x45

PassiveBuzzer buz(BUZZER_PIN);
IRrecv IR(IR_PIN);
int state = 0;

void setup() {
  IR.enableIRIn();
  pinMode(BUZZER_PIN, OUTPUT);
}

void loop() {
  if (IR.decode()) {
    if (IR.keycode == BUTTON_CODE) { 
      state += 1;

      if (state == 1) {
        buz.playTone(800, 500);
      }

      if (state == 2) {
        state = 0;
      }
    }

    IR.resume(); 
  }
}

