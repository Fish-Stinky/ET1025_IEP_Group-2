#include <Wire.h>
#include "RichShieldTM1637.h"
#include "RichShieldIRremote.h"
#include "RichShieldPassiveBuzzer.h"

#define PassiveBuzzerPin 3  
#define RECV_PIN 2          
#define LED_PIN 4           
#define BUTTON_CODE KEY_POWER 

PassiveBuzzer buz(PassiveBuzzerPin);
IRrecv IR(RECV_PIN);


int state = 0; 

void setup() {
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW); 
  
  IR.enableIRIn();            
}

void loop() {
  if (IR.decode()) {
    if (IR.isReleased()) {
      if (IR.keycode == BUTTON_CODE) {
        state += 1;
        
        if (state == 1) {
          digitalWrite(LED_PIN, HIGH);       
          buz.playTone(2500, 800);            
        }
        
        if (state == 2) {
          state = 0;                          
          digitalWrite(LED_PIN, LOW);        
          buz.playTone(1000, 800);           
        }
      }
    }
  }
}
